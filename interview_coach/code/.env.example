# Copy this file to `.env` to enable REAL scoring. Everything works without it
# (the app falls back to an offline mock scorer), so this is optional.
#
# NOTE: this key is for THE APP only. Claude Code — the AI agent you build this
# project with — is a separate tool and needs its own Anthropic credential.

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
